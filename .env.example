# MyAIValet Companion — set these ONLY as Vercel environment variables (server-side). Never commit real values.
# Already present on the project:
BLOB_READ_WRITE_TOKEN=            # Vercel Blob (private store) for lead records
# Vendasta (all four required before any Vendasta call is attempted):
VENDASTA_SERVICE_ACCOUNT_JSON=    # service account JSON (client_email/client_id, private_key, private_key_id, token_uri), scopes: knowledge + CRM
VENDASTA_PARTNER_ID=              # Partner Center partner id
VENDASTA_ACCOUNT_ID=              # MyAiValet account group
VENDASTA_CHAT_RECEPTIONIST_ID=    # ASSISTANT-… id of the MyAiValet Chat Receptionist
VENDASTA_WRITE_ENABLED=false      # must be "true" to actually write to live Vendasta
VENDASTA_WEBCHAT_WIDGET_ID=       # MyAiValet web chat widget id (public; enables the embedded Vendasta chat)
VENDASTA_API_BASE=https://prod.apigateway.co/grpc   # optional
VENDASTA_CRM_CONTACT_PATH=        # optional; confirm CRM contact-create path in Vendasta docs
# Optional:
ZAPIER_LEAD_WEBHOOK_URL=          # Catch Hook URL; receives each lead as JSON
ZAPIER_CAPTURE_WEBHOOK_URL=       # Goal #1 capture Catch Hook (server-side only; must be https://hooks.zapier.com/...)
# Knowledge-base ingest (capture -> Vendasta AI Knowledge). Writes only if VENDASTA_KB_WRITE_ENABLED=true.
VENDASTA_ACCOUNT_GROUP_ID=        # AG-… account group id
VENDASTA_AI_ASSISTANT_ID=         # ASSISTANT-… of the MyAiValet Chat Receptionist (falls back to VENDASTA_CHAT_RECEPTIONIST_ID)
VENDASTA_KB_WRITE_ENABLED=false
KB_INGEST_TOKEN=                  # optional; enables the manual /api/kb-ingest route
